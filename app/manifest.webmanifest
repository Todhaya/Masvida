{
  "name": "Viwai",
  "short_name": "Viwai",
  "description": "Ahorro sin esfuerzo para tu casa",
  "lang": "es",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#FAFAF8",
  "theme_color": "#0F0F0E",
  "icons": [
    {
      "src": "icons/icono.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "./?compartir=1",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titulo",
      "text": "texto",
      "url": "enlace",
      "files": [
        {
          "name": "archivo",
          "accept": [
            "application/pdf",
            "image/*",
            ".pdf"
          ]
        }
      ]
    }
  }
}
